<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.caso_2.PedidoController">
   <children>
      <Label layoutX="28.0" layoutY="21.0" prefHeight="31.0" prefWidth="277.0" text="Procesamiento de pedidos">
         <font>
            <Font name="System Bold" size="21.0" />
         </font>
      </Label>
      <GridPane layoutX="28.0" layoutY="72.0" prefHeight="167.0" prefWidth="429.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="209.0" minWidth="10.0" prefWidth="97.2" />
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="340.2" minWidth="10.0" prefWidth="333.2" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Pedido:">
               <font>
                  <Font name="System Bold Italic" size="19.0" />
               </font>
            </Label>
            <Label text="Pogreso:" GridPane.rowIndex="1">
               <font>
                  <Font name="System Bold Italic" size="19.0" />
               </font>
            </Label>
            <Label text="Estado:" GridPane.rowIndex="2">
               <font>
                  <Font name="System Bold Italic" size="19.0" />
               </font>
            </Label>
            <Label fx:id="lblContador" prefHeight="27.0" prefWidth="246.0" text="Pedidos Completado: 0 / 30" GridPane.columnIndex="1">
               <font>
                  <Font name="System Bold Italic" size="18.0" />
               </font>
            </Label>
            <ProgressBar fx:id="barraProgreso" prefHeight="18.0" prefWidth="297.0" progress="0.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label fx:id="lblEstado" text="Listo" GridPane.columnIndex="1" GridPane.rowIndex="2">
               <font>
                  <Font name="System Bold Italic" size="18.0" />
               </font>
            </Label>
         </children>
      </GridPane>
      <Separator layoutX="14.0" layoutY="59.0" prefHeight="0.0" prefWidth="580.0" />
      <Button fx:id="btnIniciar" defaultButton="true" layoutX="122.0" layoutY="276.0" mnemonicParsing="false" prefHeight="49.0" prefWidth="122.0" text="Inicar">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
      <Button fx:id="btnCancelar" defaultButton="true" layoutX="304.0" layoutY="275.0" mnemonicParsing="false" prefHeight="50.0" prefWidth="122.0" text="Cancelar">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Button>
   </children>
</AnchorPane>
